{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r26/joint_privacy_utility.schema.json",
  "title": "Joint privacy-utility table (Utility Evaluation, from both components)",
  "type": "object",
  "required": [
    "generated_at",
    "detection_measure",
    "rows"
  ],
  "properties": {
    "detection_measure": {
      "enum": [
        "utility_retention_pct",
        "detection_map50_95_real",
        "detection_map50_95_synthetic"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "epsilon",
          "label",
          "attack_auc_mean",
          "classifier_auc_mean",
          "utility_retention_pct"
        ]
      }
    }
  }
}
