{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r26/pipeline_report.schema.json",
  "title": "Integrated pipeline result",
  "type": "object",
  "required": [
    "project",
    "generated_at",
    "overall_verdict",
    "privacy",
    "utility",
    "compliance",
    "lineage"
  ],
  "properties": {
    "overall_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "status"
        ]
      }
    }
  }
}
